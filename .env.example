# Copy to .env for local runs of `npm start` (not used by `npm run dev`).
# On Railway, set these in the service's Variables tab instead of a file.

# Password required to view the site. Validated server-side in server.js.
SITE_PASSWORD=change-me

# Secret used to sign session cookies once a visitor enters the password.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too
